{
  "manifest_version": 3,
  "name": "Quietly Reference Saver",
  "description": "Save selected visual references from Are.na, Pinterest, and Dribbble into Quietly Inbox.",
  "version": "0.1.1",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "host_permissions": [
    "https://www.are.na/*",
    "https://are.na/*",
    "https://www.pinterest.com/*",
    "https://*.pinterest.com/*",
    "https://dribbble.com/*",
    "https://you-notebook.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quietly"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://you-notebook.vercel.app/extension-connect*",
        "http://localhost:3000/extension-connect*"
      ],
      "js": ["app-connect.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.are.na/*",
        "https://are.na/*",
        "https://www.pinterest.com/*",
        "https://*.pinterest.com/*",
        "https://dribbble.com/*"
      ],
      "js": [
        "shared/dom-helpers.js",
        "adapters/arena-adapter.js",
        "adapters/pinterest-adapter.js",
        "adapters/dribbble-adapter.js",
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
